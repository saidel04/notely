{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notely",
  "version": "0.2.0",
  "identifier": "com.notely.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notely",
        "width": 1360,
        "height": 860,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../agent/dist/notely-mcp.mjs": "agent/notely-mcp.mjs",
      "../agent/dist/pdf.worker.mjs": "agent/pdf.worker.mjs"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5RjJGNkNBMzA0MDFDRkYKUldUL0hFQXd5dmJ5Q1ZYT1F6c0RCTnZjTGEwSnZZMWFEcktrOUxNT0ZTaFNuaUFnUldFWUJlK1YK",
      "endpoints": [
        "https://github.com/saidel04/notely/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
